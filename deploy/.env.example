# <auto-generated> Edit the options records in backend/src/Core/Configuration instead and run scripts/generate.
# Every runtime configuration key, with no values. Copy to .env (git-ignored) for local use without Aspire.
# Secrets come from the secret store or managed identity in the cloud; never commit values.

# --- Auth: How every service validates access tokens. The issuer is https://login.{Tenancy:BaseDomain}.
# Internal URL of the token server's discovery document, when services can't reach the public issuer.
Auth__MetadataAddress=
# Internal URL of the token endpoint used for service tokens and token exchange, when it differs from {issuer}connect/token.
Auth__TokenEndpoint=
# Require HTTPS for the discovery document. Only turn off for an internal HTTP address on a private network.
Auth__RequireHttpsMetadata=
# Allowed clock skew for exp and nbf, in seconds (at most 30).
Auth__ClockSkewSeconds=
# How long a principal's access_version from Redis is cached in memory, in seconds.
Auth__AccessVersionCacheSeconds=
# If Redis is unavailable, how long the last known access_version is used before failing closed (503), in seconds.
Auth__AccessVersionGraceSeconds=

# --- Bff: The Gateway acting as the web app's backend-for-frontend (RFC 10017): sessions, tokens and static files.
# The Gateway's OAuth client secret (a confidential client). Must match TokenServer:PlatformClientSecrets for the BFF client. (required) (secret)
Bff__ClientSecret=
# How long a browser session lasts without activity, in days. It matches the refresh token's sliding lifetime.
Bff__SessionDays=
# When every service runs in one process (AllInOne.Host), route all /api traffic to this address instead of one host per service.
Bff__AllInOneAddress=
# Directory with the built shell app (index.html and its assets), served by the Gateway on every tenant host. Empty disables it.
Bff__ShellRoot=
# Directory with the built frontend modules, served at /mfe/{module-key}/{version}/. Empty disables it (a CDN serves them).
Bff__ModulesRoot=
# Extra origins the browser may connect to or load scripts from, besides the app itself and the module CDN (space separated).
Bff__ExtraSources=

# --- DataProtection: Protects BFF sessions, antiforgery tokens and stored secrets. The key ring is shared in Redis, wrapped by a key from the secret store.
# Key-encryption key (256 bits, base64). New keys in the ring in Redis are encrypted with it. To rotate it, put the new key here and the old one in PreviousKeyEncryptionKeys. (required) (secret)
DataProtection__KeyEncryptionKey=
# Earlier key-encryption keys (base64), used only to read ring entries written under them. Remove one once the ring entries it protects have expired (90 days after the last rotation). (secret)
DataProtection__PreviousKeyEncryptionKeys__0=
# The application name that keys are isolated by. The same for every service that must share the ring. (required)
DataProtection__ApplicationName=

# --- Database: The catalog database, tenant database servers and the database provider.
# Database provider for the catalog and every tenant database. (required)
Database__Provider=
# Connection string for the catalog database. Use managed identity (no password) in the cloud. (required) (secret)
Database__CatalogConnectionString=
# Base connection string for a tenant server or pool, without a database name. One entry per pool; 'default' is the pool new tenants use. (secret)
Database__Servers__default=
# Max Pool Size for each tenant connection string. Ceiling: tenants x instances x this value.
Database__MaxPoolSize=
# How long a tenant's resolved connection is cached, in seconds.
Database__TenantCacheSeconds=
# How many tenants the Migrator migrates in parallel with --all.
Database__MigrationParallelism=

# --- Frontend: Where the frontend modules are served from. Per-tenant versions are data in the catalog.
# Base URL of the module CDN (or '/mfe' when the Gateway serves them). Module entries are {base}/{module-key}/{version}/mf-manifest.json. (required)
Frontend__ModuleBaseUrl=
# Module version served to tenants that have no version set in the catalog. (required)
Frontend__DefaultModuleVersion=

# --- Onboarding: How the Tenancy module provisions, migrates and deletes tenants.
# The tenant server pool new tenants are placed on (a key of Database:Servers). (required)
Onboarding__DefaultServerPool=
# Command that applies one tenant's migrations. Tenancy never applies migrations itself; the pipeline's Migrator does. {tenant} is replaced by the tenant ID.
Onboarding__MigratorCommand=
# Arguments for the migrator command. {tenant} is replaced by the tenant ID.
Onboarding__MigratorArguments=
# Days a tenant stays in PendingDeletion (after its data export) before its database and files are deleted.
Onboarding__DeletionGraceDays=

# --- Operators: The platform operator realm (our own support staff).
# How long an operator's console session lasts, in minutes.
Operators__SessionMinutes=

# --- RabbitMq: The message broker (RabbitMQ 4.x, quorum queues) and the outbox relay.
# AMQP connection URI. In the cloud, use the broker's private endpoint. (required) (secret)
RabbitMq__ConnectionString=
# How many unacknowledged messages one consumer holds at a time (prefetch).
RabbitMq__Prefetch=
# How many times a failing message is tried (with growing delays) before it goes to the dead-letter queue.
RabbitMq__MaxAttempts=
# The outbox relay's slow sweep over every tenant, in minutes. It finds rows whose signal was lost.
RabbitMq__OutboxSweepMinutes=
# How many tenants the relay publishes for in parallel.
RabbitMq__RelayParallelism=
# How long published outbox rows are kept before the sweep deletes them, in days.
RabbitMq__OutboxRetentionDays=

# --- RateLimit: Distributed rate limits (Redis). A tenant's plan can override the per-tenant and per-principal limits.
# Requests per minute for one tenant, across all instances, unless the plan sets its own.
RateLimit__PerTenantPerMinute=
# Requests per minute for one principal, across all instances, unless the plan sets its own.
RateLimit__PerPrincipalPerMinute=
# Requests per minute per client address for sign-in, token, enrollment and password-reset endpoints.
RateLimit__AuthPerAddressPerMinute=
# Coarse per-instance protection: requests per second this instance accepts in total.
RateLimit__PerInstancePerSecond=

# --- Redis: The Redis-protocol store (Valkey locally) for cache, locks, rate limits and the SignalR backplane.
# StackExchange.Redis connection string. (required) (secret)
Redis__ConnectionString=

# --- ServiceClient: This service's own client credentials, for system work and for exchanging users' tokens when calling other services.
# This service's client secret (from the secret store). Its client ID is derived from its service key. (secret)
ServiceClient__ClientSecret=
# This process's own address, used for calls to services the same host runs (AllInOne.Host). Empty: http://localhost:{port of the first hosted service}.
ServiceClient__LocalAddress=

# --- Smtp: Outgoing email from the Notification module (Mailpit locally).
# SMTP server host. (required)
Smtp__Host=
# SMTP server port.
Smtp__Port=
# Use STARTTLS. Off for Mailpit, on for real servers.
Smtp__UseTls=
# SMTP user name. Leave empty if the server needs none.
Smtp__User=
# SMTP password, from the secret store. (secret)
Smtp__Password=
# The From address of platform emails. (required)
Smtp__FromAddress=
# The From name of platform emails.
Smtp__FromName=

# --- Storage: Object storage for uploaded files. Services are stateless: files never live on a container's disk.
# Which store: azure (Blob), aws (S3 or an S3-compatible emulator), or local (a folder, for development only). (required)
Storage__Provider=
# Container (Azure) or bucket (S3) holding every tenant's files. Object keys start with {tenantId}/. (required)
Storage__Container=
# Azure Blob connection string (local development with Azurite). Leave empty in the cloud and set AccountUrl, so managed identity is used. (secret)
Storage__ConnectionString=
# Azure Blob account URL, for managed identity (no secret).
Storage__AccountUrl=
# S3 service URL, only for an S3-compatible emulator such as SeaweedFS. Leave empty for AWS.
Storage__ServiceUrl=
# S3 region.
Storage__Region=
# S3 access key, for an emulator. In AWS, the task or instance role is used. (secret)
Storage__AccessKey=
# S3 secret key, for an emulator. (secret)
Storage__SecretKey=
# Folder for the local provider. Development only.
Storage__LocalPath=
# The largest upload accepted, in megabytes.
Storage__MaxUploadMegabytes=
# How long a download link works, in minutes. Links are signed and short-lived.
Storage__SignedUrlMinutes=

# --- Tenancy: How requests are mapped to tenants, and the public origins derived from the base domain.
# Base domain: tenants are served at {tenant}.{BaseDomain}, sign-in at login.{BaseDomain}. (required)
Tenancy__BaseDomain=
# Public HTTPS port of the Gateway, when it isn't 443 (local development).
Tenancy__PublicPort=

# --- TokenServer: The token server in the Identity module: keys, lifetimes, platform clients and password rules. Keys come only from the secret store.
# ES256 signing keys, PEM (EC P-256 private key). The first signs; the others stay published until their tokens expire. One entry per key. (secret)
TokenServer__SigningKeys__0=
# Encryption keys for authorization codes and refresh tokens, base64 (256 bits). The first encrypts; the others still decrypt. One entry per key. (secret)
TokenServer__EncryptionKeys__0=
# Client secrets of platform clients, by client ID (the BFF and each service). Each service holds its own in ServiceClient:ClientSecret. (secret)
TokenServer__PlatformClientSecrets__acme-bff=
# Access token lifetime for users and machines, in minutes.
TokenServer__AccessTokenMinutes=
# Access token lifetime for service principals, in minutes (5 to 15).
TokenServer__ServiceAccessTokenMinutes=
# Refresh token lifetime, in days (sliding: renewed and rotated on each use).
TokenServer__RefreshTokenDays=
# How long an emailed invitation link is valid, in hours.
TokenServer__InvitationHours=
# Require HTTPS on the token server's endpoints. Turn off only when it sits on a private network behind the Gateway, which terminates TLS (the AppHost and compose do).
TokenServer__RequireTransportSecurity=
# Reject passwords found in the Have I Been Pwned breached-password list (k-anonymity API).
TokenServer__BreachedPasswordCheck=
