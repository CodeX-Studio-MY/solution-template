<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Development only, never deployed: onboards the two demo tenants and gives them their sample data (scripts/dev-up runs it
       through the AppHost). It hosts every module so it can use their services, but serves nothing. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- A tool that is run, not a service: it is not part of the container build. -->
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>
  <Import Project="Generated/ModuleProjects.g.props" />
  <ItemGroup>
    <ProjectReference Include="..\Core.Hosting\Core.Hosting.csproj" />
  </ItemGroup>
</Project>
