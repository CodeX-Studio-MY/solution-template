<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The ONE place recurring jobs run: clustered Quartz.NET with its job store in the catalog database. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core.Hosting\Core.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="$(PlatformProductPascal).Integration.Tests" />
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
</Project>
