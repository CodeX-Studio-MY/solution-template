<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reference scenario: an add-on module entitled only in the Plus plan. It knows nothing about purchase-request:
       it reacts to the approved event from Contracts. -->
  <!-- Folders: Domain (depends on nothing), Application (on Domain), Api and Infrastructure (on Application). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\Contracts.csproj" />
    <EmbeddedResource Include="Resources\Messages.*.json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    <InternalsVisibleTo Include="$(PlatformProductPascal).Integration.Tests" />
  </ItemGroup>
</Project>
