  "components": {
    "schemas": {
      "FeatureBody": {
        "required": [
          "enabled"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "FeatureView": {
        "required": [
          "key",
          "moduleKey",
          "description",
          "default",
          "override",
          "effective"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "moduleKey": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "override": {
            "type": "boolean",
            "nullable": true
          },
          "effective": {
            "type": "boolean"
          }
        },
        "description": "A feature flag for a tenant: its default, the tenant\u0027s own choice (if any) and the result."
      },
      "JsonObject": {
        "type": "object"
      },
      "ModuleManifest": {
        "required": [
          "modules"
        ],
        "type": "object",
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModuleManifestEntry"
            }
          }
        }
      },
      "ModuleManifestEntry": {
        "required": [
          "id",
          "entry"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          }
        },
        "description": "The frontend module manifest for the signed-in tenant: which remotes the shell registers."
      },
      "OnboardRequest": {
        "required": [
          "slug",
          "displayName",
          "plan",
          "adminEmail",
          "adminName"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "adminEmail": {
            "type": "string"
          },
          "adminName": {
            "type": "string"
          },
          "serverPool": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PlanBody": {
        "required": [
          "plan"
        ],
        "type": "object",
        "properties": {
          "plan": {
            "type": "string"
          }
        }
      },
      "RequiredBody": {
        "required": [
          "required"
        ],
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          }
        }
      },
      "Role": {
        "enum": [
          "user",
          "manager",
          "admin"
        ],
        "description": "Roles, lowest to highest. A higher role includes everything a lower one can do."
      },
      "SessionDto": {
        "required": [
          "token",
          "expiresOn"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresOn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SettingInfo": {
        "required": [
          "name",
          "tenantEditable",
          "default",
          "allowedValues"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "tenantEditable": {
            "type": "boolean"
          },
          "default": {},
          "allowedValues": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "description": "One setting of a module, for the screens that edit it."
      },
      "SettingsView": {
        "required": [
          "moduleKey",
          "values",
          "overrides",
          "settings"
        ],
        "type": "object",
        "properties": {
          "moduleKey": {
            "type": "string"
          },
          "values": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "overrides": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "settings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SettingInfo"
            }
          }
        },
        "description": "A module\u0027s settings for a tenant: the effective values, what the tenant overrides, and what can be changed."
      },
      "SignInBody": {
        "required": [
          "email",
          "password",
          "totpCode"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totpCode": {
            "type": "string"
          }
        }
      },
      "SupportAccessDto": {
        "required": [
          "id",
          "tenantId",
          "tenantSlug",
          "operatorId",
          "operatorName",
          "reason",
          "role",
          "module",
          "expiresOn",
          "status"
        ],
        "type": "object",
