{
  "name": "@saaskit/api-clients",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed API clients, generated from each service's OpenAPI document (scripts/generate). Never edit src/generated by hand.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
